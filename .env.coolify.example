NODE_ENV=production
HOST=0.0.0.0
PORT=5501

# Recommended production database.
DB_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_REQUEST_TIMEOUT_MS=30000

# Use a long random value. Keep the same value when migrating from Vercel
# if you want existing sessions to survive.
JWT_SECRET=replace-this-with-a-long-random-secret

# Used by the keepalive endpoint if you keep a scheduled HTTP job.
CRON_SECRET=replace-this-with-a-random-string-at-least-16-characters-long

# Optional mail settings for email verification and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Optional Firebase compatibility.
FIREBASE_WEB_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
